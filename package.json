{
  "name": "ai-hivemind-autonomous",
  "version": "1.0.0",
  "description": "A decentralized AI economy platform enabling autonomous AI-to-AI transactions, dynamic pricing, and self-evolving strategies.",
  "main": "hardhat.config.js",
  "private": true,
  "type": "module",
  "_moduleAliases": {
    "@agents": "src/agents",
    "@ai": "src/ai",
    "@config": "src/config",
    "@contracts": "src/contracts",
    "@services": "src/services",
    "@utils": "src/utils",
    "@": "src"
  },
  "scripts": {
    "start": "ts-node src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "quantum:example": "npx tsc --outDir dist scripts/run-quantum-example.ts && node dist/scripts/run-quantum-example.js",
    "quantum:test": "node scripts/test-quantum.ts",
    "quantum:simple": "node scripts/test-quantum-simple.ts",
    "quantum:basic": "node scripts/test-quantum-basic.js",
    "quantum:direct": "node scripts/test-quantum-direct.js",
    "quantum:check-key": "node scripts/check-quantum-key.js",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "format": "prettier --write \"**/*.{js,ts,json,md,sol}\"",
    "hardhat": "hardhat",
    "compile": "hardhat compile",
    "clean": "hardhat clean",
    "node": "hardhat node",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "verify": "hardhat verify",
    "qiskit:example": "tsx examples/qiskit-assistant-example.ts"
  },
  "dependencies": {
    "@huggingface/hub": "^2.2.0",
    "@huggingface/inference": "^4.0.4",
    "@openzeppelin/contracts": "^4.9.3",
    "@qiskit/algo-ibm": "^0.9.0",
    "axios": "^1.6.2",
    "dotenv": "^16.5.0",
    "ethers": "^5.7.2",
    "qiskit": "^0.9.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-etherscan": "^3.1.7",
    "@typechain/ethers-v5": "^10.2.1",
    "@typechain/hardhat": "^6.1.0",
    "@types/chai": "^4.3.5",
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.16.0",
    "@types/winston": "^2.4.4",
    "chai": "^4.3.7",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "ethereum-waffle": "^4.0.10",
    "hardhat": "^2.16.0",
    "hardhat-gas-reporter": "^1.0.9",
    "prettier": "^3.0.3",
    "prettier-plugin-solidity": "^1.2.0",
    "solidity-coverage": "^0.8.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "typechain": "^8.3.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  },
  "lint-staged": {
    "*.{js,ts,json,md}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.sol": [
      "prettier --write"
    ]
  },
  "resolutions": {
    "ethers": "^5.7.2",
    "@typechain/ethers-v5": "^10.1.0",
    "@typechain/hardhat": "^7.0.0"
  }
}
