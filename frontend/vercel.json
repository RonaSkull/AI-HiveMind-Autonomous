{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/_next/static/(?:[^/]+/pages|pages|chunks|runtime|css|media)/.+\\.(js|css|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot|json|ico)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/service-worker.js",
      "dest": "/_next/static/service-worker.js",
      "headers": {
        "Service-Worker-Allowed": "/"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ],
  "env": {
    "NEXT_PUBLIC_CONTRACT_ADDRESS": "@ainftvault_contract_address",
    "NEXT_PUBLIC_INFURA_ID": "@infura_id"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_CONTRACT_ADDRESS": "@ainftvault_contract_address",
      "NEXT_PUBLIC_INFURA_ID": "@infura_id"
    }
  }
}
